# ─────────────────────────────────────────────
#  AAVISHIELD — Environment Configuration
# ─────────────────────────────────────────────

# App
APP_ENV=development
APP_SECRET=change-this-to-a-very-long-random-secret-string-in-production

# JWT
JWT_ACCESS_SECRET=aavishield-access-secret-change-in-production
JWT_REFRESH_SECRET=aavishield-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Internal server-to-server secret (NextAuth -> admin-api /auth/social, /portal/social)
INTERNAL_API_SECRET=change-this-to-a-long-random-string-in-production

# Social login (Google / Apple) — leave blank to keep the buttons disabled.
# Get these from Google Cloud Console (OAuth client) and Apple Developer
# (Services ID + private key). Until set, clicking the buttons will error.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=6432
POSTGRES_DB=aavishield
POSTGRES_USER=aavishield
POSTGRES_PASSWORD=aavishield_dev_password
DATABASE_URL=postgres://aavishield:aavishield_dev_password@postgres:6432/aavishield?sslmode=disable
# admin-api's Postgres connection pool. Defaults (25/10) are fine at low
# device counts; raise as agent traffic grows (bounded by Postgres's own
# max_connections). See internal/database/postgres.go.
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=10

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=aavishield_redis_dev
REDIS_URL=redis://:aavishield_redis_dev@redis:6379/0

# Admin API
ADMIN_API_PORT=6000
ADMIN_API_HOST=0.0.0.0
# Public URL/host for employee agent installers (must be reachable from employee devices)
# When exposed via the Cloudflare Tunnel (see cloudflared/config.yml), use https://aavishield-api.aavishailab.com
ADMIN_API_PUBLIC_URL=https://aavishield-api.aavishailab.com
CORS_ORIGINS=http://localhost:1001,http://localhost:1002,http://localhost:1003,http://localhost:5001,http://localhost:5002,http://localhost:5003,https://aavishield-admin.aavishailab.com,https://aavishield-app.aavishailab.com,https://aavishield-employee.aavishailab.com

# Encrypts each org's SSL Inspection root CA private key at rest (DLP over
# HTTPS). Change this in production — anyone with this value plus DB access
# could decrypt every org's CA key.
CA_KEY_ENCRYPTION_KEY=change-this-to-a-long-random-string-in-production

# DLP microservice (services/dlp-service). DLP_SERVICE_URL enables proxying
# upload scans to it; leave blank to use admin-api's in-process fallback
# scanner. DLP_SERVICE_SECRET is the shared HMAC secret both services use to
# sign/verify the org-bound service token — MUST match on both sides and be
# changed in production. Thresholds are the default score bands (per-org
# policy can override): score >= block -> block, >= alert -> alert.
#
# Every *_SERVICE_SECRET below has a matching *_SERVICE_SECRET_PREVIOUS,
# left blank here since no rotation is in progress. To rotate one without a
# downtime window: (1) set _PREVIOUS to the current value everywhere the
# microservice reads it and restart it — it now accepts both; (2) set
# _SECRET to a new value on admin-api and restart it; (3) once nothing is
# still presenting the old value (a few minutes, given these tokens'
# 5-30min TTL), clear _PREVIOUS and restart the microservice again.
DLP_SERVICE_URL=http://dlp-service:6200
DLP_SERVICE_SECRET=change-this-dlp-shared-secret-in-production
DLP_SERVICE_SECRET_PREVIOUS=
DLP_BLOCK_THRESHOLD=80
DLP_ALERT_THRESHOLD=50

# Deep-extraction microservice (services/extract-service). Same rotation
# pattern as DLP above. When EXTRACT_SERVICE_URL is set, a DLP upload is
# first unpacked (DOCX/XLSX/PPTX/PDF/ZIP/TAR/7z/images+OCR/RTF/legacy
# Office/.eml/multipart) into real text segments before scoring; blank ->
# raw bytes are scanned directly, same as before this service existed.
# EXTRACT_OCR_LANGS is passed to tesseract (space/plus-separated trained
# language packs); the shipped Dockerfile installs eng+hin.
EXTRACT_SERVICE_URL=http://extract-service:6400
EXTRACT_SERVICE_SECRET=change-this-extract-shared-secret-in-production
EXTRACT_SERVICE_SECRET_PREVIOUS=
EXTRACT_OCR_LANGS=eng+hin

# Malware microservice (services/malware-service). Same pattern as DLP:
# MALWARE_SERVICE_URL enables proxying download scans to it; blank -> admin-api
# in-process ClamAV fallback. Secret is the shared HMAC secret (match both
# sides, change in production).
MALWARE_SERVICE_URL=http://malware-service:6210
MALWARE_SERVICE_SECRET=change-this-malware-shared-secret-in-production
MALWARE_SERVICE_SECRET_PREVIOUS=
MALWARE_BLOCK_THRESHOLD=80
MALWARE_ALERT_THRESHOLD=50

# Threat-intel microservice (services/threatintel-service). Syncs free feeds
# into memory; scores domain/IP/hash reputation. Secret is the shared HMAC
# secret (match both sides, change in production).
THREATINTEL_SERVICE_URL=http://threatintel-service:6220
THREATINTEL_SERVICE_SECRET=change-this-threatintel-shared-secret-in-production
THREATINTEL_SERVICE_SECRET_PREVIOUS=

# Ed25519 keypair (server holds the private half only) that signs every
# policy bundle GetRules serves, so an agent can verify a bundle is genuine
# rather than trusting "it arrived over an authenticated connection" alone.
# Generate with:
#   openssl rand -base64 32
# Required in production — admin-api refuses to start without it there,
# rather than silently serving unsigned policy. Outside production, an
# unset value generates an ephemeral key each restart (dev convenience;
# logs a warning).
POLICY_SIGNING_KEY=
THREATINTEL_BLOCK_THRESHOLD=80
THREATINTEL_ALERT_THRESHOLD=50

# Bearer token the agent-packages CI workflow (.github/workflows/build-agent-*)
# presents when publishing a newly built .pkg/.msi/.deb. Leave empty to disable
# the upload endpoint — packages can still be dropped into the volume by hand.
AGENT_PACKAGE_UPLOAD_TOKEN=change-this-agent-package-upload-token-in-production

# Lets a superadmin trigger the "Agent packages" GitHub Actions workflow
# (.github/workflows/agent-packages.yml) straight from the dashboard instead
# of the repo's Actions tab. GITHUB_REPOSITORY is "owner/repo"; the PAT needs
# the `actions:write` permission (fine-grained) or `repo` scope (classic) on
# that repo, nothing more. Leave both empty to disable the trigger/status
# endpoints — CI still runs fine from tags/manual dispatch either way, this
# is a dashboard convenience, not a dependency.
GITHUB_REPOSITORY=
GITHUB_ACTIONS_PAT=

# Posture + GeoIP microservice (services/posture-service). Scores device
# posture from agent-reported signals and resolves IP->country. Mount a free
# country CSV (db-ip.com / ip2location LITE) at POSTURE_GEOIP_CSV for full
# geo resolution; without it, only private/reserved IPs are classified.
POSTURE_SERVICE_URL=http://posture-service:6230
POSTURE_SERVICE_SECRET=change-this-posture-shared-secret-in-production
POSTURE_SERVICE_SECRET_PREVIOUS=
POSTURE_PASS_THRESHOLD=80
POSTURE_WARN_THRESHOLD=50

# Shadow-IT discovery microservice (services/shadowit-service). Classifies
# domains against a cloud-app catalog; admin-api rolls up activity into an app
# inventory and applies sanction decisions as domain rules.
SHADOWIT_SERVICE_URL=http://shadowit-service:6240
SHADOWIT_SERVICE_SECRET=change-this-shadowit-shared-secret-in-production
SHADOWIT_SERVICE_SECRET_PREVIOUS=

# CASB microservice (services/casb-service). Inline SaaS app-control + out-of-
# band cloud file-share risk analysis.
CASB_SERVICE_URL=http://casb-service:6250
CASB_SERVICE_SECRET=change-this-casb-shared-secret-in-production
CASB_SERVICE_SECRET_PREVIOUS=

# SWG Engine
SWG_ENGINE_PORT=6001
SWG_ENGINE_HOST=0.0.0.0
SWG_DNS_PORT=6053
SWG_PROXY_PORT=6080
SWG_ADMIN_API_URL=http://admin-api:6000
# Host/port baked into Mac/Windows/Linux installers for policy enforcement proxy
# The current endpoint agent enforces locally and keeps this only for backward
# compatibility with older config files. Do not use localhost for remote agents.
SWG_PUBLIC_HOST=aavishield-api.aavishailab.com
SWG_PUBLIC_PORT=6080

# AI Service
AI_SERVICE_PORT=6002
AI_SERVICE_HOST=0.0.0.0

# admin-api -> ai-service internal auth for POST /v1/dlp/classify-image
# (DLP vision classification — Phase 3). Same rotation pattern as every
# other *_SERVICE_SECRET in this file: must match on both sides.
AI_SERVICE_URL=http://ai-service:6002
AI_SERVICE_INTERNAL_SECRET=change-this-ai-internal-shared-secret-in-production
AI_SERVICE_INTERNAL_SECRET_PREVIOUS=

# DLP vision classification (Phase 3 — "AI se images ke andar sensitive
# documents pehchano"). Blank DLP_VISION_MODEL uses the configured chat
# provider's own default model. Two model families are validated against
# kie.ai's docs (see services/ai-service/app/claude_client.py's module
# docstring for why they need different code paths):
#   DLP_VISION_MODEL=gemini-3.1-pro     # OpenAI-compatible, same per-model
#                                        # routing every other model uses
#   DLP_VISION_MODEL=claude-sonnet-4-6  # kie.ai's Anthropic-native
#                                        # /claude/v1/messages endpoint —
#                                        # a genuinely different wire
#                                        # format, handled by
#                                        # app/claude_client.py
# Changing this is a config change either way, zero code changes. The
# cache/budget below are what make this affordable in production: the same
# template screenshot is classified once ever, and a runaway caller
# degrades to OCR-only instead of an unbounded bill.
DLP_VISION_MODEL=
DLP_VISION_CACHE_TTL_SECONDS=2592000
DLP_VISION_DAILY_CAP=2000

# ─── KIE.AI LLM Provider ───────────────────
KIE_AI_API_KEY=your-kie-ai-api-key-here
KIE_AI_BASE_URL=https://api.kie.ai
KIE_AI_DEFAULT_MODEL=gemini-2.5-flash
# kie.ai serves each model at /{model}/v1/chat/completions — "per_model"
# splices the model into the URL. Use "openai" for a standard OpenAI-style host.
KIE_AI_PATH_STYLE=per_model

# Multi-LLM Config (comma-separated fallback chain)
LLM_PROVIDER_CHAIN=kie_ai
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Frontend
NEXTAUTH_SECRET=aavishield-nextauth-secret-change-in-production
# Use http://localhost:6000 / ws://localhost:6000 for local-only dev, or the
# Cloudflare Tunnel hostnames below once `docker compose up cloudflared` is running.
NEXT_PUBLIC_API_URL=https://aavishield-api.aavishailab.com
NEXT_PUBLIC_AI_URL=https://aavishield-ai.aavishailab.com
NEXT_PUBLIC_WS_URL=wss://aavishield-api.aavishailab.com

# Superadmin Frontend
SUPERADMIN_PORT=1001
NEXTAUTH_URL_SUPERADMIN=https://aavishield-admin.aavishailab.com

# Company Dashboard Frontend
COMPANY_DASHBOARD_PORT=1002
NEXTAUTH_URL_COMPANY=https://aavishield-app.aavishailab.com

# Employee Portal Frontend
EMPLOYEE_PORTAL_PORT=1003
NEXTAUTH_URL_EMPLOYEE=https://aavishield-employee.aavishailab.com

# Server-side API URL (used by NextAuth routes, not exposed to browser)
NEXTAUTH_API_URL=http://admin-api:6000

# Grafana
GRAFANA_ADMIN_PASSWORD=admin

# Feature Flags
ENABLE_SWG=true
ENABLE_AI_ASSISTANT=true
ENABLE_REAL_TIME_EVENTS=true

# Screenshot monitoring storage. Set these to use Cloudflare R2 (or any
# S3-compatible store); leave blank to keep images on the admin-api local volume.
SCREENSHOT_R2_ENDPOINT=
SCREENSHOT_R2_BUCKET=
SCREENSHOT_R2_ACCESS_KEY=
SCREENSHOT_R2_SECRET_KEY=
SCREENSHOT_R2_REGION=auto
MEDIA_SIGNING_SECRET=change-this-media-signing-secret-in-production
PUBLIC_API_URL=http://localhost:7100

# ── Razorpay (billing) — blank disables the Billing feature (fails open) ────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
