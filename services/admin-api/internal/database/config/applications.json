      "slug": "chatgpt-desktop",
      "name": "ChatGPT",
      "vendor": "OpenAI",
      "category": "ai_tools",
      "risk_level": 70,
      "description": "OpenAI's ChatGPT desktop and web client. Pasted source code, customer data and documents leave the organization through it.",
      "process_names": ["chatgpt.exe", "chatgpt", "ChatGPT"],
      "bundle_ids": ["com.openai.chat"],
      "path_patterns": ["/ChatGPT.app/", "\\OpenAI\\ChatGPT"],
      "domains": ["chatgpt.com", "chat.openai.com", "openai.com", "oaistatic.com", "oaiusercontent.com", "auth0.openai.com", "featuregates.org"]
